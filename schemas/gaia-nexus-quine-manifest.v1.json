{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypticnews.org/schemas/gaia-nexus-quine-manifest.v1.json",
  "title": "GAIA Nexus Quine Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_id", "version", "source_commit", "source_digest", "artifact_digest", "dependency_lock_digest", "build_recipe_digest", "platforms", "policy_version", "created_at", "signature"],
  "properties": {
    "schema": { "const": "gaia-nexus-quine-manifest/v1" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$" },
    "source_commit": { "type": "string", "minLength": 7 },
    "source_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "dependency_lock_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "build_recipe_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows-x64", "linux-x64", "linux-arm64", "android-arm64"] } },
    "policy_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "state_schema_version": { "type": "string" },
    "migration_digests": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "enum": ["Ed25519", "ECDSA-P256-SHA256"] },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": { "type": "array", "items": { "type": "string", "format": "uri" } }
  }
}
